{
  "name": "team-harness-platform",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run native:surface && tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "native:build": "docker build -t team-native-harness:0.2.0-rc.2-team.2 native-harness",
    "verify:native": "tsx scripts/verify-native-compatibility.ts",
    "magpie:build": "python3 scripts/build-magpie.py",
    "native:surface": "node scripts/build-native-surface.mjs"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.63",
    "@ai-sdk/google": "4.0.80",
    "@ai-sdk/openai": "4.0.75",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "bonjour-service": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "ws": "8.21.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
