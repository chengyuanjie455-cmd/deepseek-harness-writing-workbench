# Copy to a local, untracked .env file. Never commit real values.
PLATFORM_DATA_ROOT=/path/to/private/data
PLATFORM_BIND=127.0.0.1
PLATFORM_PORT=4325
# Provider keys are configured by the administrator on the deployment host.
# Optional Magpie Google OAuth values; keep real values only in the untracked .env.
MAGPIE_GEMINI_OAUTH_CLIENT_ID=
MAGPIE_GEMINI_OAUTH_CLIENT_SECRET=
MAGPIE_ANTIGRAVITY_OAUTH_CLIENT_ID=
MAGPIE_ANTIGRAVITY_OAUTH_CLIENT_SECRET=
